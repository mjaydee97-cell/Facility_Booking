PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/facility_booking
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
APP_TIMEZONE=Asia/Manila

# Booking rules
CHECKIN_EARLY_MIN=15
CHECKIN_GRACE_MIN=15
REMINDER_MINUTES_BEFORE=30
MAX_BOOKING_HOURS=8
MAX_ADVANCE_DAYS=60

# Firebase service-account JSON (Firebase console > Project settings > Service accounts).
# Leave empty to disable push; the in-app notification inbox still works.
GOOGLE_APPLICATION_CREDENTIALS=
